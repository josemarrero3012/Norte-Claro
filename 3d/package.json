{
  "name": "norte-claro-3d",
  "private": true,
  "version": "1.0.0",
  "description": "Piezas 3D de Norte Claro: modelos de Blender (blender/) y visor Three.js (src/). Genera lib/3d y assets/3d.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/norte3d.js --bundle --format=esm --minify --target=es2020 --legal-comments=none --outfile=../lib/3d/norte3d.js",
    "modelos": "gltfpack -i blender/export/brujula.glb -o ../assets/3d/brujula.glb -cc -kn -km && gltfpack -i blender/export/mapa.glb -o ../assets/3d/mapa.glb -cc -kn -km",
    "watch": "esbuild src/norte3d.js --bundle --format=esm --target=es2020 --sourcemap --outfile=../lib/3d/norte3d.js --watch"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gltfpack": "1.3.0",
    "three": "0.186.1",
    "world-atlas": "2.0.2"
  }
}
